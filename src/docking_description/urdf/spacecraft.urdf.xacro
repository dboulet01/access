<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spacecraft">
  <xacro:arg name="name" default="chaser" />
  <xacro:arg name="color" default="0.15 0.35 0.75 1" />

  <link name="base_link">
    <inertial>
      <mass value="250.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="70" ixy="0" ixz="0" iyy="90" iyz="0" izz="90" />
    </inertial>
    <visual>
      <geometry><box size="1.2 1.0 1.0" /></geometry>
      <material name="body"><color rgba="$(arg color)" /></material>
    </visual>
    <collision>
      <geometry><box size="1.2 1.0 1.0" /></geometry>
    </collision>
  </link>

  <link name="docking_port">
    <visual>
      <origin rpy="0 1.57079632679 0" />
      <geometry><cylinder radius="0.22" length="0.18" /></geometry>
      <material name="port"><color rgba="0.65 0.68 0.72 1" /></material>
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" />
      <geometry><cylinder radius="0.22" length="0.18" /></geometry>
    </collision>
  </link>

  <joint name="docking_port_joint" type="fixed">
    <parent link="base_link" />
    <child link="docking_port" />
    <origin xyz="0.69 0 0" />
  </joint>
</robot>