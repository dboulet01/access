<?xml version="1.0"?>
<package format="3">
  <name>docking_orchestration</name>
  <version>0.1.0</version>
  <description>Simulation orchestration and baseline docking controller.</description>
  <maintainer email="maintainer@example.com">Secure Docking Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>docking_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>