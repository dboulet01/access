<?xml version="1.0"?>
<sdf version="1.8">
  <world name="docking">
    <gravity>0 0 0</gravity>
    <physics name="microgravity" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster" />

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="target">
      <static>true</static>
      <pose>0 0 0 0 0 3.14159265359</pose>
      <link name="body">
        <visual name="body_visual">
          <geometry><box><size>1.6 1.4 1.4</size></box></geometry>
          <material><ambient>0.65 0.22 0.18 1</ambient><diffuse>0.65 0.22 0.18 1</diffuse></material>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>1.6 1.4 1.4</size></box></geometry>
        </collision>
        <visual name="port_visual">
          <pose>0.9 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chaser">
      <static>false</static>
      <pose>-5 0 0 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>250</mass>
          <inertia><ixx>70</ixx><iyy>90</iyy><izz>90</izz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>1.2 1.0 1.0</size></box></geometry>
          <material><ambient>0.12 0.34 0.72 1</ambient><diffuse>0.12 0.34 0.72 1</diffuse></material>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>1.2 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="port_visual">
          <pose>0.69 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>