# ACCESS simulation configuration. Copy to .env for local overrides; .env is ignored.
ACCESS_IDENTITIES_FILE=/workspace/config/access/simulation-identities.json
ACCESS_TRUST_BUNDLE_FILE=/workspace/config/access/simulation-trust-bundle.json
ACCESS_PROTOCOL_PROFILE_FILE=/workspace/config/access/access-protocol-profile.json
ACCESS_AUTHORIZATION_POLICY_BUNDLE_FILE=/workspace/config/access/access-authorization-policy-bundle.json
ACCESS_AUTHORITY_COMMAND=/usr/local/bin/access-authority
ACCESS_SIGNER_COMMAND=/usr/local/bin/access-signer
ACCESS_STATE_DIR=/workspace/state/access-authority
ACCESS_AUTHORITY_TIMEOUT_S=5
ACCESS_ENTITLEMENT_VERIFIER_COMMAND=/usr/local/bin/access-entitlement-verifier
ACCESS_ENTITLEMENT_VERIFIER_TIMEOUT_S=5
ACCESS_CLIENT_TRUST_BUNDLE_FILE=/workspace/config/access/simulation-client-trust-bundle.json
ACCESS_CLIENT_REPLAY_FILE=/workspace/state/access-client/consumed-entitlements.log

# Production deployments must replace the file provider with an HSM/KMS provider,
# authenticate authorization-policy and trust bundles before activation, mount them read-only,
# and never place private key material in this repository.