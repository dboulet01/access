{
  "schema_version": "1.0",
  "policy_id": "commercial-docking-v3",
  "policy_version": 3,
  "valid_from": "2026-01-01T00:00:00Z",
  "valid_until": "2027-01-01T00:00:00Z",
  "station_id": "station:waystation-1",
  "ports": ["port-3"],
  "trust_bundle": {
    "bundle_id": "waystation-1-trust",
    "minimum_version": 42,
    "maximum_age_s": 604800
  },
  "defaults": {
    "no_matching_policy": "deny",
    "indeterminate": "deny",
    "abort_active": "deny"
  },
  "credential_profiles": [
    {
      "profile_id": "registered-vehicle-v1",
      "credential_type": "VehicleRegistrationCredential",
      "schema_id": "space:vehicle-registration:v1",
      "issuer_groups": ["recognized-registrars"],
      "subject_binding": "vehicle",
      "maximum_status_age_s": 604800
    },
    {
      "profile_id": "idss-compatible-v1",
      "credential_type": "DockingCertificationCredential",
      "schema_id": "space:docking-certification:v1",
      "issuer_groups": ["recognized-docking-authorities"],
      "subject_binding": "vehicle",
      "claim_profile": "idss-port-compatible-v1",
      "maximum_status_age_s": 86400
    }
  ],
  "stage_policies": [
    {
      "rule_id": "enter-approach",
      "action": "enter_approach",
      "from_stage": "hold",
      "to_stage": "approach",
      "required_credential_profiles": ["registered-vehicle-v1"],
      "holder_proof_required": true,
      "required_session_status": "pending",
      "maximum_proof_age_s": 60,
      "readiness": {
        "maximum_age_ms": 1000,
        "required_checks": ["initial_hold_confirmed", "retreat_available"]
      },
      "entitlement_ttl_s": 60,
      "constraints": { "max_closing_rate_mps": 0.6 },
      "obligations": ["AUDIT_DECISION", "CONSUME_ENTITLEMENT_ON_USE", "ABORT_ON_CONSTRAINT_VIOLATION"]
    },
    {
      "rule_id": "enter-final-approach",
      "action": "enter_final_approach",
      "from_stage": "approach",
      "to_stage": "final_approach",
      "required_credential_profiles": ["registered-vehicle-v1", "idss-compatible-v1"],
      "holder_proof_required": true,
      "required_session_status": "authorized",
      "maximum_proof_age_s": 30,
      "readiness": {
        "maximum_age_ms": 500,
        "required_checks": ["relative_navigation_valid", "approach_corridor_clear", "closing_rate_within_limit"]
      },
      "entitlement_ttl_s": 30,
      "constraints": { "max_closing_rate_mps": 0.2, "max_range_m": 1.12 },
      "obligations": ["AUDIT_DECISION", "CONSUME_ENTITLEMENT_ON_USE", "RECHECK_OPERATIONAL_READINESS", "ABORT_ON_CONSTRAINT_VIOLATION"]
    },
    {
      "rule_id": "engage-soft-capture",
      "action": "engage_soft_capture",
      "from_stage": "final_approach",
      "to_stage": "soft_capture",
      "required_credential_profiles": ["idss-compatible-v1"],
      "holder_proof_required": true,
      "required_session_status": "authorized",
      "maximum_proof_age_s": 30,
      "readiness": {
        "maximum_age_ms": 250,
        "required_checks": ["alignment_within_limit", "closing_rate_within_limit", "capture_system_ready"]
      },
      "entitlement_ttl_s": 15,
      "constraints": { "max_closing_rate_mps": 0.1, "max_range_m": 0.32 },
      "obligations": ["AUDIT_DECISION", "CONSUME_ENTITLEMENT_ON_USE", "RECHECK_OPERATIONAL_READINESS", "ABORT_ON_CONSTRAINT_VIOLATION"]
    },
    {
      "rule_id": "engage-hard-dock",
      "action": "engage_hard_dock",
      "from_stage": "soft_capture",
      "to_stage": "hard_dock",
      "required_credential_profiles": ["idss-compatible-v1"],
      "holder_proof_required": true,
      "required_session_status": "authorized",
      "maximum_proof_age_s": 15,
      "readiness": {
        "maximum_age_ms": 100,
        "required_checks": ["soft_capture_confirmed", "latches_ready", "relative_motion_stable"]
      },
      "entitlement_ttl_s": 10,
      "constraints": { "max_closing_rate_mps": 0.05, "max_range_m": 0.04 },
      "obligations": ["AUDIT_DECISION", "CONSUME_ENTITLEMENT_ON_USE", "RECHECK_OPERATIONAL_READINESS", "MONITOR_SESSION_REVOCATION", "ABORT_ON_CONSTRAINT_VIOLATION"]
    }
  ]
}