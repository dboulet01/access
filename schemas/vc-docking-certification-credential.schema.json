{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-docking.example/schemas/vc-docking-certification-credential.schema.json",
  "title": "DockingCertificationCredential (W3C VC 2.0 profile)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "type",
    "id",
    "issuer",
    "validFrom",
    "validUntil",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 1,
      "contains": { "const": "https://www.w3.org/ns/credentials/v2" }
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "contains": { "const": "DockingCertificationCredential" },
      "allOf": [
        { "contains": { "const": "VerifiableCredential" } }
      ]
    },
    "id": { "type": "string", "format": "uri" },
    "issuer": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "type": "string", "format": "uri" } }
        }
      ]
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSchema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vehicleId",
        "interfaceStandard",
        "interfaceVersion",
        "compatiblePortProfiles",
        "certificationAuthority",
        "certificationStatus"
      ],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "vehicleId": { "type": "string", "minLength": 1 },
        "interfaceStandard": { "const": "IDSS" },
        "interfaceVersion": { "type": "string", "minLength": 1 },
        "compatiblePortProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "certificationAuthority": { "type": "string", "minLength": 1 },
        "certificationStatus": { "enum": ["active", "suspended", "revoked", "expired"] },
        "maxCertifiedClosingRateMps": { "type": "number", "minimum": 0 },
        "maxCertifiedMassKg": { "type": "number", "minimum": 0 }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "proofPurpose", "verificationMethod", "created"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "cryptosuite": { "type": "string", "minLength": 1 },
        "proofPurpose": { "const": "assertionMethod" },
        "verificationMethod": { "type": "string", "format": "uri" },
        "created": { "type": "string", "format": "date-time" },
        "proofValue": { "type": "string", "minLength": 1 }
      }
    }
  }
}
