{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-space.example/schemas/client-trust-bundle.schema.json",
  "title": "ACCESS client authority trust bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "version",
    "client_id",
    "valid_from",
    "valid_until",
    "trusted_authorities"
  ],
  "properties": {
    "bundle_id": { "$ref": "#/$defs/non_empty" },
    "version": { "type": "integer", "minimum": 1 },
    "client_id": { "$ref": "#/$defs/non_empty" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "environment": { "$ref": "#/$defs/non_empty" },
    "trusted_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_id", "signing_keys"],
        "properties": {
          "authority_id": { "$ref": "#/$defs/non_empty" },
          "signing_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key_id", "algorithm", "public_key_hex"],
              "properties": {
                "key_id": { "$ref": "#/$defs/non_empty" },
                "algorithm": { "const": "Ed25519" },
                "public_key_hex": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
