{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-docking.example/schemas/authorization-decision.schema.json",
  "title": "Docking authorization decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "decision_id",
    "evaluation_id",
    "request_id",
    "evaluated_at",
    "outcome",
    "policy",
    "reason_codes",
    "evidence",
    "obligations"
  ],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "decision_id": { "$ref": "#/$defs/non_empty" },
    "evaluation_id": { "$ref": "#/$defs/non_empty" },
    "request_id": { "$ref": "#/$defs/non_empty" },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "outcome": { "enum": ["allow", "deny", "indeterminate"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "bundle_version", "policy_id", "policy_hash"],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/non_empty" },
        "bundle_version": { "type": "integer", "minimum": 1 },
        "policy_id": { "$ref": "#/$defs/non_empty" },
        "policy_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ALLOW_POLICY_SATISFIED",
          "DENY_ISSUER_NOT_STAGED",
          "DENY_ISSUER_OUT_OF_SCOPE",
          "DENY_CREDENTIAL_MISSING",
          "DENY_CREDENTIAL_INVALID",
          "DENY_CREDENTIAL_EXPIRED",
          "DENY_CREDENTIAL_REVOKED",
          "DENY_SUBJECT_MISMATCH",
          "DENY_HOLDER_PROOF_INVALID",
          "DENY_AUDIENCE_MISMATCH",
          "DENY_REPLAY",
          "DENY_SESSION_NOT_AUTHORIZED",
          "DENY_SESSION_EXPIRED",
          "DENY_INVALID_TRANSITION",
          "DENY_OPERATIONAL_READINESS",
          "DENY_POLICY_CONSTRAINT",
          "DENY_ABORT_ACTIVE",
          "INDETERMINATE_TRUST_BUNDLE_EXPIRED",
          "INDETERMINATE_REVOCATION_STATE_STALE",
          "INDETERMINATE_CLOCK_UNTRUSTED",
          "INDETERMINATE_UNSUPPORTED_SCHEMA",
          "INDETERMINATE_INTERNAL_ERROR"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "digest", "result"],
        "properties": {
          "type": {
            "enum": ["trust_bundle", "issuer", "credential", "holder_proof", "session", "readiness", "revocation", "clock"]
          },
          "id": { "$ref": "#/$defs/non_empty" },
          "digest": { "$ref": "#/$defs/digest" },
          "result": { "enum": ["pass", "fail", "unknown"] },
          "reason": { "$ref": "#/$defs/non_empty" }
        }
      }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "AUDIT_DECISION",
          "CONSUME_ENTITLEMENT_ON_USE",
          "RECHECK_OPERATIONAL_READINESS",
          "MONITOR_SESSION_REVOCATION",
          "RETURN_TO_HOLD_ON_EXPIRY",
          "ABORT_ON_CONSTRAINT_VIOLATION"
        ]
      }
    },
    "entitlement": { "$ref": "#/$defs/entitlement" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "allow" } }, "required": ["outcome"] },
      "then": {
        "required": ["entitlement"],
        "properties": {
          "reason_codes": {
            "maxItems": 1,
            "items": { "const": "ALLOW_POLICY_SATISFIED" }
          }
        }
      },
      "else": { "not": { "required": ["entitlement"] } }
    },
    {
      "if": { "properties": { "outcome": { "const": "deny" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "reason_codes": { "items": { "pattern": "^DENY_" } }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "indeterminate" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "reason_codes": { "items": { "pattern": "^INDETERMINATE_" } }
        }
      }
    }
  ],
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^(sha-256|sha-384|sha-512):[A-Za-z0-9_-]+$" },
    "base64url": { "type": "string", "minLength": 22, "pattern": "^[A-Za-z0-9_-]+$" },
    "stage": { "enum": ["approach", "final_approach", "soft_capture", "hard_dock", "servicing", "departure"] },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_closing_rate_mps": { "type": "number", "minimum": 0 },
        "max_range_m": { "type": "number", "minimum": 0 },
        "resource_type": { "$ref": "#/$defs/non_empty" },
        "max_quantity": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entitlement_id",
        "issuer",
        "subject",
        "audience",
        "station_id",
        "port_id",
        "mission_id",
        "session_id",
        "action",
        "authorized_stage",
        "not_before",
        "expires_at",
        "sequence_number",
        "request_nonce",
        "policy_hash",
        "single_use",
        "constraints"
      ],
      "properties": {
        "entitlement_id": { "$ref": "#/$defs/non_empty" },
        "issuer": { "$ref": "#/$defs/non_empty" },
        "subject": { "$ref": "#/$defs/non_empty" },
        "audience": { "$ref": "#/$defs/non_empty" },
        "station_id": { "$ref": "#/$defs/non_empty" },
        "port_id": { "$ref": "#/$defs/non_empty" },
        "mission_id": { "$ref": "#/$defs/non_empty" },
        "session_id": { "$ref": "#/$defs/non_empty" },
        "action": { "$ref": "#/$defs/non_empty" },
        "authorized_stage": { "$ref": "#/$defs/stage" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "sequence_number": { "type": "integer", "minimum": 0 },
        "request_nonce": { "$ref": "#/$defs/base64url" },
        "policy_hash": { "$ref": "#/$defs/digest" },
        "single_use": { "const": true },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    }
  }
}