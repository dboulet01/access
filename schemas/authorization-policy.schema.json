{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-docking.example/schemas/authorization-policy.schema.json",
  "title": "Station docking authorization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "valid_from",
    "valid_until",
    "station_id",
    "trust_bundle",
    "defaults",
    "credential_profiles",
    "stage_policies"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_id": { "$ref": "#/$defs/non_empty" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "station_id": { "$ref": "#/$defs/non_empty" },
    "ports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty" }
    },
    "trust_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "minimum_version", "maximum_age_s"],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/non_empty" },
        "minimum_version": { "type": "integer", "minimum": 1 },
        "maximum_age_s": { "type": "integer", "minimum": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_matching_policy", "indeterminate", "abort_active"],
      "properties": {
        "no_matching_policy": { "const": "deny" },
        "indeterminate": { "const": "deny" },
        "abort_active": { "const": "deny" }
      }
    },
    "credential_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "credential_type", "schema_id", "issuer_groups", "subject_binding"],
        "properties": {
          "profile_id": { "$ref": "#/$defs/non_empty" },
          "credential_type": { "$ref": "#/$defs/non_empty" },
          "schema_id": { "$ref": "#/$defs/non_empty" },
          "issuer_groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/non_empty" }
          },
          "subject_binding": { "enum": ["vehicle", "operator", "controller"] },
          "claim_profile": { "$ref": "#/$defs/non_empty" },
          "maximum_status_age_s": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "stage_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "action",
          "from_stage",
          "to_stage",
          "required_credential_profiles",
          "holder_proof_required",
          "required_session_status",
          "readiness",
          "entitlement_ttl_s",
          "obligations"
        ],
        "properties": {
          "rule_id": { "$ref": "#/$defs/non_empty" },
          "action": { "$ref": "#/$defs/action" },
          "from_stage": { "$ref": "#/$defs/stage" },
          "to_stage": { "$ref": "#/$defs/stage" },
          "required_credential_profiles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/non_empty" }
          },
          "holder_proof_required": { "type": "boolean" },
          "required_session_status": { "enum": ["pending", "authorized"] },
          "maximum_proof_age_s": { "type": "integer", "minimum": 0 },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximum_age_ms", "required_checks"],
            "properties": {
              "maximum_age_ms": { "type": "integer", "minimum": 0 },
              "required_checks": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/non_empty" }
              }
            }
          },
          "entitlement_ttl_s": { "type": "integer", "minimum": 1, "maximum": 300 },
          "constraints": { "$ref": "#/$defs/constraints" },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/obligation" }
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "timestamp": { "type": "string", "format": "date-time" },
    "stage": { "enum": ["hold", "approach", "final_approach", "soft_capture", "hard_dock", "servicing", "departure"] },
    "action": { "enum": ["enter_approach", "enter_final_approach", "engage_soft_capture", "engage_hard_dock", "open_service_interface", "transfer_resource", "disconnect", "depart"] },
    "obligation": { "enum": ["AUDIT_DECISION", "CONSUME_ENTITLEMENT_ON_USE", "RECHECK_OPERATIONAL_READINESS", "MONITOR_SESSION_REVOCATION", "RETURN_TO_HOLD_ON_EXPIRY", "ABORT_ON_CONSTRAINT_VIOLATION"] },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_closing_rate_mps": { "type": "number", "minimum": 0 },
        "max_range_m": { "type": "number", "minimum": 0 },
        "resource_type": { "$ref": "#/$defs/non_empty" },
        "max_quantity": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}