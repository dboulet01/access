{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-docking.example/schemas/vc-access-presentation.schema.json",
  "title": "ACCESS credential presentation (W3C VP 2.0 profile)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "type",
    "holder",
    "verifiableCredential",
    "proof",
    "accessBinding"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 1,
      "contains": { "const": "https://www.w3.org/ns/credentials/v2" }
    },
    "type": {
      "type": "array",
      "minItems": 1,
      "contains": { "const": "VerifiablePresentation" }
    },
    "holder": { "type": "string", "format": "uri" },
    "verifiableCredential": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "array",
                "contains": { "const": "VerifiableCredential" }
              }
            }
          },
          {
            "type": "string",
            "contentEncoding": "base64"
          }
        ]
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "proofPurpose",
        "verificationMethod",
        "challenge",
        "domain",
        "created"
      ],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "cryptosuite": { "type": "string", "minLength": 1 },
        "proofPurpose": { "const": "authentication" },
        "verificationMethod": { "type": "string", "format": "uri" },
        "challenge": { "type": "string", "minLength": 16 },
        "domain": { "type": "string", "minLength": 1 },
        "created": { "type": "string", "format": "date-time" },
        "proofValue": { "type": "string", "minLength": 1 }
      }
    },
    "accessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "encounterId",
        "stationId",
        "portId",
        "missionId",
        "requestNonce"
      ],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "encounterId": { "type": "string", "minLength": 1 },
        "stationId": { "type": "string", "minLength": 1 },
        "portId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "requestNonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,}$"
        }
      }
    }
  }
}
